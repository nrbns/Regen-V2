{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "./dist/renderer",
    "rootDir": "./",
    "types": ["node"],
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "incremental": true
  },
  "include": ["src", "src/**/*.json", "src/vite-env.d.ts", "services/**/*.ts", "packages/**/*.ts", "core/**/*.ts"],
  "exclude": [
    "server",
    "node_modules",
    "dist",
    "dist-web",
    "src/ui/**",
    "src/preload/**",
    "src/modes/**",
    "src/services/**",
    "src/lib/tabLifecycle.ts",
    "src/routes/AIPanelRoute.tsx",
    "src/routes/OfflineDocuments.tsx",
    "src/routes/PlaybookForge.tsx",
    "src/state/agentStreamStore.ts",
    "src/state/appStore.ts",
    "src/shims/framer-motion.tsx",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/__tests__/**",
    "**/__mocks__/**"
  ]
}
