{
  "productName": "Regen",
  "version": "1.0.0",
  "identifier": "com.regen.app",
  "build": {
    "beforeDevCommand": "node scripts/vite-dev-tauri.js",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:tauri",
    "frontendDist": "../dist-web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Regen Browser",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "visible": true,
        "focus": true,
        "center": true,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "externalBin": [],
    "copyright": "Copyright © 2025 Regen Browser",
    "category": "Utility",
    "shortDescription": "Next-generation AI automation platform",
    "longDescription": "Regen Browser: AI-powered web automation with voice, trade, and research modes",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "entitlements": null,
      "exceptionDomain": null,
      "signingIdentity": null
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "global-shortcut": {
      "enable": true
    },
    "updater": {
      "active": false,
      "dialog": true,
      "endpoints": [
        "https://github.com/nrbns/Regen-V2/releases/latest/download/latest.json"
      ],
      "pubkey": "REPLACE_WITH_CONTENTS_OF_regen-update.key.pub"
    }
  }
}
